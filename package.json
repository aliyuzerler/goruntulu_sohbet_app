{
  "name": "randchat-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "RandChat — random video chat platform (Flutter + NestJS)",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:api": "pnpm --filter @randchat/api dev",
    "build:api": "pnpm --filter @randchat/api build",
    "build:shared": "pnpm --filter @randchat/shared build",
    "test:api": "pnpm --filter @randchat/api test:e2e",
    "lint:api": "pnpm --filter @randchat/api lint",
    "infra:up": "bash infra/scripts/dev-up.sh",
    "infra:down": "bash infra/scripts/dev-down.sh",
    "db:migrate": "pnpm --filter @randchat/api prisma:migrate",
    "db:seed": "pnpm --filter @randchat/api prisma:seed",
    "prettier": "prettier --write \"**/*.{ts,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  }
}
