# ─── Core ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
SERVICE_NAME=randchat-api
SERVICE_VERSION=0.1.0

# ─── Database ─────────────────────────────────────────
# Matches docker-compose.yml in /infra
DATABASE_URL=postgresql://randchat:randchat@localhost:5432/randchat?schema=public

# ─── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── S3-compatible storage (MinIO dev) ───────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=randchat_minio
S3_SECRET_KEY=randchat_minio_secret_2024
S3_BUCKET=randchat-assets
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/randchat-assets

# ─── Auth (Phase 2) ─────────────────────────────────
JWT_ACCESS_SECRET=dev_access_secret_change_me_in_prod_32_chars_min
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_in_prod_32_chars_min
JWT_ACCESS_TTL=900            # 15 min (seconds)
JWT_REFRESH_TTL=2592000       # 30 days (seconds)

# Firebase Admin SDK — leave empty to enable DEV BYPASS mode (CI + local).
# When set, real firebase-admin is used to verify idTokens.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Dev bypass — comma-separated E.164 phones + Google subject IDs that the
# API will accept without real Firebase. Only effective when FIREBASE_PROJECT_ID is empty.
FIREBASE_DEV_BYPASS_PHONES=+905555555555,+905555555556
GOOGLE_DEV_BYPASS_SUBJECTS=dev-google-test-1

# ─── Agora (Phase 4) ─────────────────────────────────
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ─── AWS Rekognition (Phase 4) ───────────────────────
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REKOGNITION_MIN_CONFIDENCE=60
REKOGNITION_FRAME_INTERVAL_SECONDS=15

# ─── Google Play Billing (Phase 6) ───────────────────
GOOGLE_PLAY_PACKAGE_NAME=com.randchat.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# RTDN webhook bearer token — Pub/Sub push endpoint verifies this.
# Generate with: openssl rand -hex 32 — set the same value in Pub/Sub push config.
RTDN_BEARER_TOKEN=

# ─── FCM Push (Phase 7) ──────────────────────────────
FCM_SERVER_KEY=

# ─── Observability ───────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=debug

# ─── CORS ────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8081,http://localhost:8082

# ─── Socket.IO (Phase 3) ────────────────────────────
SOCKET_IO_CORS_ORIGINS=*
# Heartbeat: client must send a heartbeat event every HEARTBEAT_INTERVAL_SEC seconds.
# Server drops the connection if no heartbeat received within HEARTBEAT_TTL_SEC seconds.
HEARTBEAT_INTERVAL_SEC=30
HEARTBEAT_TTL_SEC=90
# Latency measurement: server emits a ping every LATENCY_PING_INTERVAL_SEC seconds.
LATENCY_PING_INTERVAL_SEC=15
# Redis adapter channel prefix — must be the same across all API instances.
SOCKET_IO_ADAPTER_CHANNEL_PREFIX=socket.io
# Connection quality thresholds (ms) — used by client to show green/yellow/red.
LATENCY_GOOD_MS=200
LATENCY_FAIR_MS=500

# ─── Matchmaking + Economy (Phase 5) ─────────────────
# Daily free match quota — after this, matches cost COIN_COST_PER_MATCH coins.
DAILY_FREE_MATCH_QUOTA=10
# Coin cost per paid match (after free quota exhausted).
COIN_COST_PER_MATCH=2
# Cooldown between consecutive skips (Next button spam prevention).
MATCH_COOLDOWN_SEC=3
# Max consecutive skips before a 30s timeout is applied.
MAX_CONSECUTIVE_SKIPS=5
SKIP_TIMEOUT_SEC=30
# Country-priority TTL — users wait in country queue for this long before
# being demoted to the global pool.
COUNTRY_PRIORITY_TTL_SEC=45

# ─── IAP — Phase 6 coin packs ─────────────────────────────
# Product IDs must match Google Play Console SKUs.
COIN_PACK_SMALL_ID=coin_pack_small
COIN_PACK_SMALL_AMOUNT=10
COIN_PACK_SMALL_PRICE=$0.99
COIN_PACK_MEDIUM_ID=coin_pack_medium
COIN_PACK_MEDIUM_AMOUNT=60
COIN_PACK_MEDIUM_PRICE=$4.99
COIN_PACK_LARGE_ID=coin_pack_large
COIN_PACK_LARGE_AMOUNT=150
COIN_PACK_LARGE_PRICE=$9.99
COIN_PACK_MEGA_ID=coin_pack_mega
COIN_PACK_MEGA_AMOUNT=400
COIN_PACK_MEGA_PRICE=$24.99
# RTDN webhook shared secret — set in Google Pub/Sub push endpoint URL
# as ?token=<secret> or as a custom header. Leave empty for dev bypass.
GOOGLE_PLAY_WEBHOOK_SECRET=

# ─── VIP + Filters (Phase 7) ─────────────────────────────────
# Play Console subscription product ID for VIP monthly.
VIP_PRODUCT_ID=vip_monthly
# Cost (coins) to activate the country filter for 24h. VIP users get it free.
COIN_COST_COUNTRY_FILTER=20
COUNTRY_FILTER_DURATION_HOURS=24
# Matchmaking fairness: how long (seconds) before filters relax.
#   - Country filter enforced for first 15s → relaxed after
#   - Gender filter enforced for first 30s → relaxed after
# Nobody waits forever — after these thresholds, anyone matches anyone.
FAIRNESS_RELAX_COUNTRY_SEC=15
FAIRNESS_RELAX_GENDER_SEC=30

# ─── Moderation (Phase 8) ────────────────────────────────────
# Strike system: 1=warning, 2=24h cooldown, 3+ = permanent ban.
STRIKE_COOLDOWN_HOURS=24
STRIKE_BAN_LEVEL=3
# AWS Rekognition labels that trigger automatic NSFW action.
NSFW_LABELS=Explicit Nudity,Suggestive,Explicit Bikini,Adult,Drugs
# In-call chat filters.
CHAT_PROFANITY_ENABLED=true
CHAT_LINK_BLOCK_ENABLED=true

# ─── Security hardening (Phase 9) ──────────────────────────
# Ban evasion prevention — block banned users from creating new accounts
# from the same device or with the same phone number.
BAN_EVASION_ENABLED=true
# Report spam decay — if a reporter files >N reports against the same target
# in 24h, their report weight drops to REPORT_DECAYED_WEIGHT (counter-attack defense).
REPORT_WEIGHT_DECAY_THRESHOLD=5
REPORT_DECAYED_WEIGHT=0.1
# WebSocket per-socket message limit (per 10 seconds).
WS_MSG_LIMIT_PER_10S=30
# Minimum client app version — below this, the forced-update screen is shown.
MIN_APP_VERSION=0.0.0
